{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cmdrvl/spine-rules/schemas/operator.v1.schema.json",
  "title": "operator.v1",
  "description": "Canonical contract for a spine tool. Backs both `<tool> --describe` (operator.json) and `<tool> capabilities --json`; the two must be byte-for-byte the same document. NOTE: validate() in spine-rules (OperatorContract::validate) is authoritative. JSON Schema cannot express: tool_version == Cargo.toml version, unique command/refusal/env_var/format names, or `doctor` implying exit 1 beyond the fixed `required` list. This schema must never be looser than validate() on what it can express; tests/contract.rs runs planted documents through both.",
  "type": "object",
  "allOf": [
    {
      "description": "expected_change on exit 1 requires the --exit-zero-on-change option.",
      "if": {
        "required": ["exit_codes"],
        "properties": { "exit_codes": { "required": ["1"], "properties": { "1": { "required": ["domain"], "properties": { "domain": { "const": "expected_change" } } } } } }
      },
      "then": {
        "required": ["options"],
        "properties": {
          "options": { "contains": { "type": "object", "required": ["flag"], "properties": { "flag": { "const": "--exit-zero-on-change" } } } }
        }
      }
    }
  ],
  "required": [
    "schema_version",
    "name",
    "tool_version",
    "contract_version",
    "description",
    "commands",
    "exit_codes",
    "refusals",
    "env_vars",
    "formats",
    "side_effects",
    "pipeline"
  ],
  "properties": {
    "schema_version": { "const": "operator.v1" },
    "name": { "type": "string", "minLength": 1 },
    "tool_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+].*)?$", "description": "Must equal the Cargo.toml package version." },
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+].*)?$" },
    "description": { "type": "string", "minLength": 1 },
    "repository": { "type": "string" },
    "license": { "type": "string" },
    "agent_guide": { "type": "string" },
    "invocation": {
      "type": "object",
      "required": ["binary"],
      "properties": {
        "binary": { "type": "string" },
        "usage": { "type": "array", "items": { "type": "string" } },
        "output_mode": { "type": "string" },
        "output_schema": { "type": "string" },
        "json_flag": { "type": "string" }
      }
    },
    "arguments": { "type": "array" },
    "options": { "type": "array" },
    "commands": {
      "type": "array",
      "description": "Must include capabilities, robot-docs and doctor. Names must be unique (not expressible here).",
      "allOf": [
        { "contains": { "type": "object", "properties": { "name": { "const": "capabilities" } }, "required": ["name"] } },
        { "contains": { "type": "object", "properties": { "name": { "const": "robot-docs" } }, "required": ["name"] } },
        { "contains": { "type": "object", "properties": { "name": { "const": "doctor" } }, "required": ["name"] } }
      ],
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "authored_inputs": { "type": "array", "items": { "$ref": "#/$defs/authored_input" } },
          "refusals": { "type": "array", "items": { "$ref": "#/$defs/refusal" } }
        }
      }
    },
    "exit_codes": {
      "type": "object",
      "required": ["0", "1", "2"],
      "description": "0 positive; 1 negative | expected_change | unhealthy; 2 error; 3 policy. `1` is required because every tool declares `doctor`. See docs/exit-codes.md.",
      "propertyNames": { "enum": ["0", "1", "2", "3"] },
      "properties": {
        "0": { "$ref": "#/$defs/exit_code_positive" },
        "1": { "$ref": "#/$defs/exit_code_one" },
        "2": { "$ref": "#/$defs/exit_code_error" },
        "3": { "$ref": "#/$defs/exit_code_policy" }
      },
      "additionalProperties": false
    },
    "refusals": { "type": "array", "items": { "$ref": "#/$defs/refusal" } },
    "env_vars": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "description": { "type": "string" },
          "default": { "type": "string" }
        }
      }
    },
    "formats": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "side_effects": {
      "type": "object",
      "required": ["reads_files", "writes_files", "network", "writes_witness"],
      "properties": {
        "reads_files": { "type": "boolean" },
        "writes_files": { "type": "boolean" },
        "network": { "type": "boolean" },
        "writes_witness": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "pipeline": {
      "type": "object",
      "required": ["upstream", "downstream"],
      "properties": {
        "upstream": { "type": "array", "items": { "type": "string" } },
        "downstream": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "exit_code_positive": { "type": "object", "required": ["meaning", "domain"], "properties": { "meaning": { "type": "string" }, "domain": { "const": "positive" } } },
    "exit_code_one": { "type": "object", "required": ["meaning", "domain"], "properties": { "meaning": { "type": "string" }, "domain": { "enum": ["negative", "expected_change", "unhealthy"] } } },
    "exit_code_error": { "type": "object", "required": ["meaning", "domain"], "properties": { "meaning": { "type": "string" }, "domain": { "const": "error" } } },
    "exit_code_policy": { "type": "object", "required": ["meaning", "domain"], "properties": { "meaning": { "type": "string" }, "domain": { "const": "policy" } } },
    "refusal": {
      "type": "object",
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "pattern": "^E_" },
        "message": { "type": "string" },
        "action": { "type": "string" },
        "tool": { "type": "string" },
        "flag": { "type": "string" }
      }
    },
    "authored_input": {
      "type": "object",
      "required": ["name", "schema_flag", "example"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "schema_flag": { "enum": ["--input-schema", "--schema"] },
        "example": { "type": "string", "minLength": 1 },
        "allowed_values": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
